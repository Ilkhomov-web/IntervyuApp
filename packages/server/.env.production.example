# Production Environment Variables for Server (Strapi)

# Server Configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=1337

# Database Configuration (PostgreSQL)
DATABASE_HOST=<your-db-host>
DATABASE_PORT=5432
DATABASE_NAME=my_app_production
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<secure-password>
DATABASE_TLS=true
DATABASE_POOL_SIZE_MAX=10

# Strapi Secrets (REGENERATE ALL FOR PRODUCTION)
# Generate each with: openssl rand -base64 32
APP_KEYS=<key1>,<key2>,<key3>,<key4>
API_TOKEN_SALT=<generate>
ADMIN_JWT_SECRET=<generate>
TRANSFER_TOKEN_SALT=<generate>
JWT_SECRET=<generate>
ENCRYPTION_KEY=<generate>

# Client URL (for CORS)
CLIENT_URL=https://yourdomain.com
