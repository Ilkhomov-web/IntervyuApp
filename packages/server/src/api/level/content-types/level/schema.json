{
  "kind": "collectionType",
  "collectionName": "levels",
  "info": {
    "singularName": "level",
    "pluralName": "levels",
    "displayName": "Level",
    "description": "Junior / Middle / Senior darajalari"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 1
    },
    "description": {
      "type": "text"
    },
    "minTopicsCompleted": {
      "type": "integer",
      "default": 0
    },
    "minAverageScore": {
      "type": "integer",
      "default": 70,
      "min": 0,
      "max": 100
    },
    "topics": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::topic.topic",
      "mappedBy": "level"
    }
  }
}
