{
  "kind": "collectionType",
  "collectionName": "topics",
  "info": {
    "singularName": "topic",
    "pluralName": "topics",
    "displayName": "Topic",
    "description": "O'qish mavzulari (Closures, Hooks, System Design...)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "theory": {
      "type": "richtext"
    },
    "importance": {
      "type": "integer",
      "required": true,
      "default": 5,
      "min": 1,
      "max": 10
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard"],
      "default": "medium",
      "required": true
    },
    "estimatedMinutes": {
      "type": "integer",
      "default": 30
    },
    "tags": {
      "type": "json"
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "track": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::track.track",
      "inversedBy": "topics"
    },
    "level": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::level.level",
      "inversedBy": "topics"
    },
    "prerequisites": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::topic.topic"
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question.question",
      "mappedBy": "topic"
    },
    "practicalTasks": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::practical-task.practical-task",
      "mappedBy": "topic"
    }
  }
}
