{
  "kind": "collectionType",
  "collectionName": "practical_tasks",
  "info": {
    "singularName": "practical-task",
    "pluralName": "practical-tasks",
    "displayName": "Practical Task",
    "description": "Amaliy topshiriqlar (kod yozish)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "topic": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::topic.topic",
      "inversedBy": "practicalTasks"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "richtext",
      "required": true
    },
    "starterCode": {
      "type": "text"
    },
    "solutionCode": {
      "type": "text"
    },
    "testCases": {
      "type": "json"
    },
    "hints": {
      "type": "json"
    },
    "difficulty": {
      "type": "enumeration",
      "enum": ["easy", "medium", "hard"],
      "default": "medium",
      "required": true
    },
    "estimatedMinutes": {
      "type": "integer",
      "default": 30
    },
    "language": {
      "type": "enumeration",
      "enum": ["javascript", "typescript", "html", "css", "react", "node"],
      "default": "javascript"
    },
    "attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::attempt.attempt",
      "mappedBy": "practicalTask"
    }
  }
}
