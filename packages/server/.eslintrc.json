{
  "root": true,
  "extends": ["airbnb"],
  "parser": "@babel/eslint-parser",
  "parserOptions": {
    "requireConfigFile": false,
    "babelOptions": {
      "plugins": ["@babel/plugin-syntax-import-assertions"]
    }
  },
  "env": {
    "commonjs": true,
    "es2021": true,
    "node": true
  },
  "rules": {
    "no-console": 0,
    "import/prefer-default-export": "off",
    "no-unused-vars": "warn",
    "no-param-reassign": "warn",
    "camelcase": "warn"
  }
}
