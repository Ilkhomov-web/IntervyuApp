{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@config": ["src/config"],
      "@components/*": ["src/common/components/*"],
      "@hooks/*": ["src/common/hooks/*"],
      "@lib/*": ["src/common/lib/*"],
      "@slices/*": ["src/common/slices/*"],
      "@services/*": ["src/common/services/*"],
      "@store": ["src/common/store"],
      "@utils": ["src/common/utils"],
      "@utils/*": ["src/common/utils/*"],
      "@modules/*": ["src/modules/*"]
    },
    "target": "ES6",
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true
  }
}
